<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Themed Card Pack Simulator</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#111522;color:#f6f4ef;font:15px system-ui}#app{max-width:1050px;margin:auto;padding:18px}
header{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}h1{margin:0;font-size:clamp(23px,4vw,34px)}.muted{color:#aeb7c9}.stats,.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.stat,.panel{background:#1d2536;border:1px solid #39445a;border-radius:15px;padding:12px}.stat b{display:block;color:#ffdc83;font-size:20px}.tabs button,button{border:0;border-radius:10px;padding:10px 13px;background:#394761;color:white;font-weight:750;cursor:pointer}.tabs button.active{background:#f5c95c;color:#211b13}main{display:grid;grid-template-columns:1fr 1.1fr;gap:14px}.opening{min-height:425px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.pack{width:210px;height:285px;border:3px solid #ffe0a1;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;box-shadow:0 18px 40px #0008,inset 0 0 25px #fff3;position:relative;transform:rotate(-2deg);background:linear-gradient(135deg,#7c321e,#d88735,#5b2a1c)}.pack:before,.pack:after{content:"";position:absolute;left:0;right:0;height:12px;background:repeating-linear-gradient(90deg,#fff8 0 7px,#0002 7px 12px);border-block:1px solid #fff8}.pack:before{top:0}.pack:after{bottom:0}.brand{font-size:11px;letter-spacing:3px;font-weight:900;background:#0005;padding:5px 10px;border-radius:20px}.emoji{font-size:72px;filter:drop-shadow(0 5px 3px #0007)}.packname{font-size:23px;font-weight:1000;text-shadow:0 3px 4px #0008;line-height:1.05}.edition{font-size:10px;letter-spacing:2px;font-weight:800}.spooky{background:linear-gradient(135deg,#25183f,#6e3c82,#19152b)}.pirate{background:linear-gradient(135deg,#432b1c,#b17a39,#29202a)}.bug{background:linear-gradient(135deg,#164c32,#5b9e4e,#163c2c)}.dog{background:linear-gradient(135deg,#71421e,#d69a48,#8b552b)}.breakfast{background:linear-gradient(135deg,#9a5416,#ffc94f,#d97925);border-color:#fff0a7}#open{margin-top:24px;background:linear-gradient(90deg,#f5c451,#e98e37);color:#241b15;font-size:17px;padding:13px 30px}#result{min-height:55px;margin-top:13px;font-weight:850;font-size:18px}.collection{max-height:550px;overflow:auto}.rarity{font-weight:900;margin:12px 0 5px}.pet{display:flex;align-items:center;gap:9px;padding:7px;border-bottom:1px solid #30394c}.face{width:42px;height:42px;flex:0 0 42px;display:inline-block;position:relative;border-radius:13px 13px 11px 11px;background:var(--blook,#c8e2f5);box-shadow:inset 0 -4px 0 #0000000b,0 2px 5px #0003;overflow:hidden}
.face:before{content:"";position:absolute;left:8px;top:12px;width:9px;height:11px;border-radius:50%;background:#17131d;box-shadow:17px 0 0 #17131d,-2px 10px 0 -2px #f28ca8,19px 10px 0 -2px #f28ca8}
.face:after{content:"";position:absolute;left:15px;top:24px;width:12px;height:8px;background:#17131d;border-radius:0 0 12px 12px}
.face .mini{position:absolute;right:1px;bottom:0;font-style:normal;font-size:13px;filter:drop-shadow(0 1px 1px #fff)}
.face.ghost{--blook:#c5e0f5;border-radius:14px 14px 12px 12px;clip-path:polygon(0 0,100% 0,100% 86%,86% 100%,70% 92%,52% 100%,34% 92%,15% 100%,0 90%)}
.face.locked{filter:brightness(0);opacity:.8}
.face.bug{--blook:#c9edb8}.face.dog{--blook:#f2d4aa}.face.food{--blook:#ffe2a4}.face.spooky{--blook:#d9c5f2}.details{flex:1}.details small{color:#aeb7c9}.pet button{font-size:12px;padding:6px 9px;background:#8a6a2e}.recent{display:flex;gap:7px;flex-wrap:wrap}.pull{background:#2a3347;padding:7px 9px;border-radius:9px;font-size:13px}.wave{animation:wave .85s ease-in-out infinite alternate}@keyframes wave{to{filter:brightness(2.2);transform:scale(1.04)}}@media(max-width:700px){main{grid-template-columns:1fr}.opening{min-height:380px}.collection{max-height:none}}
</style></head><body><div id="app">
<header><div><h1>🎴 Themed Card Pack Simulator</h1><div class="muted">Open packs, discover Blooks, and complete your collection.</div></div><div class="stats"><div class="stat">Packs opened<b id="opened">0</b></div><div class="stat">Discovered<b id="discovered">0 / 0</b></div><div class="stat">Tokens<b id="tokens">0</b></div></div></header>
<nav class="tabs" id="tabs"></nav>
<main><section class="panel opening"><div class="pack" id="art"><div class="brand">BLOOK COLLECTION</div><div class="emoji" id="packEmoji">🍂</div><div class="packname" id="packName">AUTUMN<br>PACK</div><div class="edition">LIMITED EDITION</div></div><button id="open">OPEN PACK</button><div id="result">Choose a pack and open it!</div><div class="muted">Duplicates increase your count. Bug Pack rewards tokens on first discovery.</div></section>
<section class="panel"><h2>📚 Collection <small class="muted" id="collectionTitle"></small></h2><div class="collection" id="collection"></div><h2>🕘 Recent pulls</h2><div class="recent" id="recent"></div></section></main></div>
<script>
const packs={
autumn:{label:"Autumn Pack 2026",emoji:"🍂",cls:"",pets:[
["Uncommon","Black Bear","🐻",19.5],["Uncommon","Pumpkin Pie","🥧",19.5],["Uncommon","Chipmunk","🐿️",19.5],["Uncommon","Cornucopia","🧺",19.5],["Rare","Autumn Cat","🐈",6],["Rare","Pumpkin Puppy","🐕",6],["Rare","Red Squirrel","🐿️",6],["Epic","Autumn Crow","🐦‍⬛",2.95],["Legendary","Turkey","🦃",1],["Chroma","Pumpkin Spice Latte","☕",.05]]},
spooky:{label:"Spooky Pack 2026",emoji:"🎃",cls:"spooky",pets:[
["Uncommon","Pumpkin","🎃",3.04],["Uncommon","Swamp Monster","🧟",3.04],["Uncommon","Frankenstein","🧟‍♂️",3.04],["Uncommon","Vampire","🧛",3.04],["Uncommon","Zombie","🧟‍♀️",3.04],["Rare","Mummy","🧻",4],["Rare","Caramel Apple","🍎",4],["Rare","Candy Corn","🍬",4],["Rare","Crow","🐦‍⬛",4],["Rare","Vampire Bat","🦇",4],["Epic","Werewolf","🐺",.825],["Epic","Goo Monster","🟢",.825],["Legendary","Ghost","👻",.65],["Chroma","Spooky Moth","🦋",.05]]},
pirate:{label:"Pirate Pack",emoji:"🏴‍☠️",cls:"pirate",pets:[
["Uncommon","Deckhand","⚓",16],["Uncommon","Buccaneer","🏴‍☠️",16],["Uncommon","Swashbuckler","🗡️",16],["Uncommon","Treasure Map","🗺️",16],["Uncommon","Seagull","🕊️",16],["Rare","Jolly Pirate","☠️",8],["Rare","Pirate Ship","🚢",8],["Epic","Kraken","🐙",3.67],["Legendary","Captain Blackbeard","🏴‍☠️",.3],["Chroma","Pirate Pufferfish","🐡",.03]]},
bug:{label:"Bug Pack",emoji:"🐛",cls:"bug",pets:[
["Uncommon","Ant","🐜",19.625,5],["Uncommon","Rhino Beetle","🪲",19.625,5],["Uncommon","Ladybug","🐞",19.625,5],["Uncommon","Fly","🪰",19.625,5],["Rare","Worm","🪱",9,20],["Rare","Bee","🐝",9,20],["Epic","Mantis","🦗",2.97,75],["Legendary","Butterfly","🦋",.5,200],["Chroma","Blue Butterfly","🦋",.03,300]]},
dog:{label:"Dog Pack",emoji:"🐶",cls:"dog",pets:[
["Uncommon","Jack Russell Terrier","🐶",15,5],["Uncommon","Chihuahua","🐕",15,5],["Uncommon","Yorkshire Terrier","🐕",15,5],["Uncommon","Poodle","🐩",15,5],["Uncommon","German Shepherd","🐕",15,5],["Rare","Saint Bernard","🐶",7,20],["Rare","Golden Retriever","🐕",7,20],["Rare","Dalmatian","🐕",7,20],["Epic","Bloodhound","🐕",3.57,75],["Legendary","Old English Sheepdog","🐶",.4,200],["Chroma","Robot Dog","🤖",.03,300]]},
breakfast:{label:"Breakfast Pack",emoji:"🍳",cls:"breakfast",pets:[
["Uncommon","Toast","🍞",12.5],["Uncommon","Cereal","🥣",12.5],["Uncommon","Yogurt","🥛",12.5],["Uncommon","Breakfast Combo","🍳",12.5],["Uncommon","Orange Juice","🧃",12.5],["Uncommon","Milk","🥛",12.5],["Rare","Waffle","🧇",9],["Rare","Pancakes","🥞",9],["Epic","French Toast","🍞",5],["Epic","Pizza","🍕",2]]}
};
const order=["Uncommon","Rare","Epic","Legendary","Chroma"],color={Uncommon:"#6edb82",Rare:"#66aaff",Epic:"#c184ff",Legendary:"#ffd45e",Chroma:"#5de8e2"};
let current="autumn",counts={},opened=0,tokens=0,history=[],busy=false;
const $=id=>document.getElementById(id),k=(p,n)=>p+"|"+n;
try{let s=JSON.parse(localStorage.getItem("packSimSave")||"{}");counts=s.counts||{};opened=s.opened||0;tokens=s.tokens||0;history=s.history||[]}catch(e){}
const allPets=()=>Object.values(packs).reduce((a,p)=>a+p.pets.length,0),found=()=>Object.values(counts).filter(x=>x>0).length;
function save(){localStorage.setItem("packSimSave",JSON.stringify({counts,opened,tokens,history}))}
function stats(){$("opened").textContent=opened;$("discovered").textContent=found()+" / "+allPets();$("tokens").textContent=tokens}
function tabs(){$("tabs").innerHTML=Object.entries(packs).map(([id,p])=>`<button data-id="${id}" class="${id===current?"active":""}">${p.emoji} ${p.label}</button>`).join("")}
function choose(id){current=id;let p=packs[id];$("art").className="pack "+p.cls;$("packEmoji").textContent=p.emoji;$("packName").innerHTML=p.label.replace(" Pack","<br>PACK").toUpperCase();$("collectionTitle").textContent="— "+p.label;tabs();collection();$("result").textContent="Ready to open "+p.label+"!"}
function collection(){$("collection").innerHTML=order.map(r=>`<div class="rarity" style="color:${color[r]}">${r}</div>`+packs[current].pets.filter(x=>x[0]===r).map(x=>{let n=counts[k(current,x[1])]||0;return `<div class="pet"><span class="face ${n?(x[1]==="Ghost"?"ghost":current==="bug"?"bug":current==="dog"?"dog":current==="breakfast"?"food":current==="spooky"?"spooky":""):"locked"}">${n?`<i class="mini">${x[2]}</i>`:""}</span><div class="details"><b>${n?x[1]:"???"}</b><br><small>${n?"Owned: "+n+" · "+x[3]+"%":"Undiscovered · "+x[3]+"%"}</small></div>${current==="dog"&&n?`<button data-sell="${x[1]}">Sell +${x[4]} 🪙</button>`:""}</div>`}).join("")).join("")}
function recent(){$("recent").innerHTML=history.slice(0,12).map(x=>`<span class="pull" style="border-left:3px solid ${color[x.r]}">${x.e} ${x.n}</span>`).join("")||'<span class="muted">Your pulls appear here.</span>'}
function pick(){let a=packs[current].pets,total=a.reduce((s,x)=>s+x[3],0),v=Math.random()*total;for(let x of a){v-=x[3];if(v<0)return x}return a[a.length-1]}
function openPack(){if(busy)return;busy=true;let x=pick(),id=k(current,x[1]),first=!counts[id];counts[id]=(counts[id]||0)+1;opened++;if(current==="bug"&&first)tokens+=x[4]||0;history.unshift({n:x[1],e:x[2],r:x[0]});history=history.slice(0,30);$("art").classList.add("wave");$("result").textContent="✨ Opening...";$("open").disabled=true;setTimeout(()=>{$("art").classList.remove("wave");$("result").innerHTML=`<div style="display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap"><span class="face ${x[1]==="Ghost"?"ghost":current==="bug"?"bug":current==="dog"?"dog":current==="breakfast"?"food":current==="spooky"?"spooky":""}" style="width:76px;height:76px;flex-basis:76px;transform:scale(1.08)"><i class="mini" style="font-size:23px">${x[2]}</i></span><span><span style="color:${color[x[0]]}">${x[0].toUpperCase()}!</span><br>${x[1]}${first?" — NEW DISCOVERY!":""}${current==="bug"&&first?" (+"+x[4]+" tokens)":""}</span></div>`;$("open").disabled=false;busy=false;stats();collection();recent();save()},1050)}
$("tabs").addEventListener("click",e=>{let b=e.target.closest("[data-id]");if(b)choose(b.dataset.id)});
$("open").onclick=openPack;
$("collection").addEventListener("click",e=>{let b=e.target.closest("[data-sell]");if(!b)return;let x=packs.dog.pets.find(p=>p[1]===b.dataset.sell),id=k("dog",x[1]);if(!counts[id])return;counts[id]--;tokens+=x[4];stats();collection();save();$("result").textContent=`Sold one ${x[1]} for ${x[4]} tokens!`});
tabs();stats();choose("autumn");recent();
</script></body></html>
